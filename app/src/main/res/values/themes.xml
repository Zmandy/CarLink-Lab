<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarLifeLab" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonStyle">@style/Widget.CarLink.Button</item>
        <item name="android:editTextStyle">@style/Widget.CarLink.Input</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Widget.CarLink.Button" parent="android:style/Widget.Material.Button">
        <item name="android:background">@drawable/dashboard_card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.CarLink.Input" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/dashboard_card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
    </style>
</resources>
