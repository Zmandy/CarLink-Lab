<resources>
 <style name="Theme.CarLifeLab.Base" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans-serif</item><item name="android:buttonStyle">@style/Widget.CarLink.Button</item><item name="android:editTextStyle">@style/Widget.CarLink.Input</item>
  <item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">@color/surface</item><item name="android:navigationBarColor">#405273</item><item name="android:windowBackground">@color/surface</item><item name="android:colorAccent">@color/primary</item><item name="android:windowActionModeOverlay">true</item><item name="android:windowSoftInputMode">adjustResize</item>
 </style>
 <style name="Theme.CarLifeLab" parent="Theme.CarLifeLab.Base" />
