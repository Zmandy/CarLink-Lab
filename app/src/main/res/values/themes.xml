 </style>
 <style name="Widget.CarLink.PrimaryButton" parent="Widget.CarLink.Button"><item name="android:background">@drawable/glass_primary</item><item name="android:textColor">#FFFFFF</item><item name="android:elevation">2dp</item></style>
 <style name="Widget.CarLink.Input" parent="android:style/Widget.Material.Light.EditText"><item name="android:background">@drawable/glass_input</item><item name="android:backgroundTint">@null</item><item name="android:textColor">@color/text_primary</item><item name="android:textColorHint">@color/text_secondary</item><item name="android:minHeight">56dp</item><item name="android:minWidth">0dp</item><item name="android:padding">14dp</item></style>
</resources>