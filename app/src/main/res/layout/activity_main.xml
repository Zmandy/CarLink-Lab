<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="CARLINK LAB" android:textSize="13sp" android:textColor="@color/primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="每一次出发，都心中有数" android:textSize="27sp" android:textColor="@color/text_primary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="车辆仪表 · 胎压监测 · 行程油耗" android:textSize="14sp" android:textColor="@color/text_secondary" />
        <Button android:id="@+id/carlife_client" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/primary" android:textColor="@color/surface" android:textAllCaps="false" android:text="连接车辆与实时仪表" />
        <Button android:id="@+id/tpms_dashboard" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="仪表外观预览 · 演示数据" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="本地音乐" android:textSize="18sp" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/now_playing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/no_track_selected" android:textColor="@color/text_primary" android:textSize="16sp" android:paddingBottom="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/previous" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="上一首" />
            <Button android:id="@+id/play_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="播放" />
            <Button android:id="@+id/next" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="下一首" />
        </LinearLayout>
        <Button android:id="@+id/open_audio" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="选择音乐" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_not_connected" android:textColor="@color/text_secondary" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" android:text="连接诊断" android:textSize="18sp" android:textColor="@color/text_primary" />
        <Button android:id="@+id/open_carlife" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="打开官方 CarLife" />
        <Button android:id="@+id/usb_diagnostics" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="USB 连接检查" />
        <Button android:id="@+id/tpms_scan" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="ELM327 协议扫描" />
        <Button android:id="@+id/probe_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginBottom="8dp" android:background="@drawable/dashboard_card" android:backgroundTint="@color/surface_variant" android:textColor="@color/text_primary" android:textAllCaps="false" android:text="CarLife 通道检查" />
    </LinearLayout>
</ScrollView>