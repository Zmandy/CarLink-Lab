<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_height="match_parent" android:id="@+id/glass_scroll" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none" android:layout_width="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:paddingBottom="28dp" android:descendantFocusability="beforeDescendants" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:text="CarLink" android:textSize="28sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:text="与爱车，轻盈相连" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_launcher_legacy" android:contentDescription="@string/app_name" android:layout_marginBottom="12dp" />
            <TextView android:text="每一次出发&#10;都心中有数" android:textSize="30sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="胎压、胎温与实时油耗，一眼掌握。" android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/carlife_client" android:text="连接车辆与实时仪表" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.CarLink.PrimaryButton" />
            <Button android:id="@+id/tpms_dashboard" android:text="仪表预览 · 演示数据" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="随行音乐" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="尚未选择歌曲" android:textSize="17sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" android:id="@+id/now_playing" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/previous" android:text="上一首" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Button android:id="@+id/play_pause" android:text="播放" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Widget.CarLink.PrimaryButton" android:layout_weight="1" android:layout_marginStart="12dp" />
                <Button android:id="@+id/next" android:text="下一首" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <Button android:id="@+id/open_audio" android:text="选择音乐" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="选择音乐后即可播放" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="连接与诊断" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/open_carlife" android:text="打开官方 CarLife" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/usb_diagnostics" android:text="USB 连接检查" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/tpms_scan" android:text="ELM327 协议扫描" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/probe_button" android:text="CarLife 通道检查" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
