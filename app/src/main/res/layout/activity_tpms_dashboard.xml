<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageButton android:id="@+id/glass_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/glass_button" android:src="@drawable/ic_back" android:contentDescription="@string/glass_back" android:padding="12dp" android:layout_marginEnd="14dp" />
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <TextView android:text="仪表预览" android:textSize="28sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="演示数据 · 与真实车辆无关" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/tpms_preview" android:layout_height="0dp" android:layout_weight="1" android:adjustViewBounds="true" android:contentDescription="@string/tpms_dashboard" android:scaleType="fitCenter" android:layout_width="match_parent" />
    <TextView android:text="模拟数据源" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:gravity="center" android:layout_marginTop="8dp" android:padding="8dp" android:id="@+id/tpms_status" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
