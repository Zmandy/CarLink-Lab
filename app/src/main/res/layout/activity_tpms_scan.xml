<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_height="match_parent" android:id="@+id/glass_scroll" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none" android:layout_width="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:paddingBottom="28dp" android:descendantFocusability="beforeDescendants" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageButton android:id="@+id/glass_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/glass_button" android:src="@drawable/ic_back" android:contentDescription="@string/glass_back" android:padding="12dp" android:layout_marginEnd="14dp" />
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:text="协议扫描" android:textSize="28sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:text="WiFi ELM327 · 读取诊断" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="适配器连接" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="未连接 WiFi ELM327" android:textSize="13sp" android:textColor="@color/primary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:id="@+id/scan_status" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="地址与端口" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:labelFor="@id/scan_host" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@+id/scan_host" android:text="192.168.0.10" android:hint="IP 地址" android:inputType="textUri" android:singleLine="true" android:textSize="16sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <EditText android:id="@+id/scan_port" android:text="35000" android:hint="端口" android:inputType="number" android:singleLine="true" android:textSize="16sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/scan_connect" android:text="连接" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Widget.CarLink.PrimaryButton" android:layout_weight="1" />
                <Button android:id="@+id/scan_disconnect" android:text="断开" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="扫描范围" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="CAN 请求头" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:labelFor="@id/scan_headers" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/scan_headers" android:text="7A0" android:hint="多个请求头用逗号分隔" android:inputType="textCapCharacters" android:singleLine="true" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="起始 DID 与结束 DID" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:labelFor="@id/scan_start_did" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@+id/scan_start_did" android:text="C000" android:hint="起始 DID" android:inputType="textCapCharacters" android:singleLine="true" android:textSize="16sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <EditText android:id="@+id/scan_end_did" android:text="C0FF" android:hint="结束 DID" android:inputType="textCapCharacters" android:singleLine="true" android:textSize="16sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/scan_start" android:text="开始扫描" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Widget.CarLink.PrimaryButton" android:layout_weight="1" />
                <Button android:id="@+id/scan_stop" android:text="停止扫描" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView android:text="@string/tpms_scan_warning" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="扫描记录" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/scan_copy" android:text="复制扫描记录" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="连接日志" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <ScrollView android:layout_height="220dp" android:background="@drawable/glass_inset" android:padding="14dp" android:nestedScrollingEnabled="true" android:layout_marginTop="10dp" android:layout_width="match_parent">
                <TextView android:text="" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:fontFamily="monospace" android:textIsSelectable="true" android:id="@+id/scan_log" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
