<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_height="match_parent" android:id="@+id/glass_scroll" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none" android:layout_width="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:paddingBottom="28dp" android:descendantFocusability="beforeDescendants" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageButton android:id="@+id/glass_back" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/glass_button" android:src="@drawable/ic_back" android:contentDescription="@string/glass_back" android:padding="12dp" android:layout_marginEnd="14dp" />
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:text="车辆连接" android:textSize="28sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:text="四轮状态与实时油耗" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="车辆状态" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="后台连接已停止" android:textSize="13sp" android:textColor="@color/primary" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" android:id="@+id/client_status" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="左前&#10;等待数据" android:textSize="16sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:background="@drawable/glass_inset" android:padding="14dp" android:minHeight="88dp" android:id="@+id/client_tire_fl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <TextView android:text="右前&#10;等待数据" android:textSize="16sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:background="@drawable/glass_inset" android:padding="14dp" android:minHeight="88dp" android:id="@+id/client_tire_fr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="左后&#10;等待数据" android:textSize="16sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:background="@drawable/glass_inset" android:padding="14dp" android:minHeight="88dp" android:id="@+id/client_tire_rl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <TextView android:text="右后&#10;等待数据" android:textSize="16sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:background="@drawable/glass_inset" android:padding="14dp" android:minHeight="88dp" android:id="@+id/client_tire_rr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView android:text="等待车辆连接" android:textSize="19sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:layout_marginTop="14dp" android:padding="14dp" android:background="@drawable/glass_inset" android:id="@+id/client_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="连接设置" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="ELM327 地址与端口" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:labelFor="@id/client_host" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@+id/client_host" android:text="192.168.0.10" android:hint="IP 地址" android:inputType="textUri" android:singleLine="true" android:textSize="16sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <EditText android:id="@+id/client_port" android:text="35000" android:hint="端口" android:inputType="number" android:singleLine="true" android:textSize="16sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/client_start" android:text="开始连接" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Widget.CarLink.PrimaryButton" android:layout_weight="1" />
                <Button android:id="@+id/client_stop" android:text="停止连接" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="仪表偏好" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="欢迎标题" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:labelFor="@id/client_title" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <EditText android:id="@+id/client_title" android:text="欢迎公主上车" android:hint="欢迎标题" android:inputType="text" android:singleLine="true" android:textSize="16sp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="油价省份与汽油标号" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:labelFor="@id/client_province" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText android:id="@+id/client_province" android:text="上海" android:hint="油价省份" android:inputType="text" android:singleLine="true" android:textSize="16sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <EditText android:id="@+id/client_fuel_grade" android:text="92#" android:hint="汽油标号" android:inputType="text" android:singleLine="true" android:textSize="16sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="后台运行" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:text="" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="12dp" android:id="@+id/client_battery_status" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <Button android:id="@+id/client_battery" android:text="后台运行设置" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp" android:layout_marginBottom="16dp" android:elevation="2dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="诊断记录" android:textSize="18sp" android:textColor="@color/text_primary" android:lineSpacingExtra="3dp" android:textStyle="bold" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/client_toggle_log" android:text="展开 / 收起日志" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Button android:id="@+id/client_copy" android:text="复制日志" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView android:text="连接日志" android:textSize="13sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginBottom="8dp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <ScrollView android:layout_height="220dp" android:background="@drawable/glass_inset" android:padding="14dp" android:nestedScrollingEnabled="true" android:layout_marginTop="10dp" android:id="@+id/client_log_panel" android:visibility="gone" android:layout_width="match_parent">
                <TextView android:text="" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:fontFamily="monospace" android:textIsSelectable="true" android:id="@+id/client_log" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
