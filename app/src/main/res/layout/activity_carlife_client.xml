<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/surface" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/carlife_client_title" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/carlife_client_hint" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <TextView android:id="@+id/client_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/carlife_client_status_idle" android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
      <TextView android:id="@+id/client_tire_fl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="0dp" android:padding="16dp" android:background="@drawable/dashboard_card" android:text="左前 · 等待数据" android:textColor="@color/text_primary" android:textSize="16sp" />
      <TextView android:id="@+id/client_tire_fr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:padding="16dp" android:background="@drawable/dashboard_card" android:text="右前 · 等待数据" android:textColor="@color/text_primary" android:textSize="16sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
      <TextView android:id="@+id/client_tire_rl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="0dp" android:padding="16dp" android:background="@drawable/dashboard_card" android:text="左后 · 等待数据" android:textColor="@color/text_primary" android:textSize="16sp" />
      <TextView android:id="@+id/client_tire_rr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:padding="16dp" android:background="@drawable/dashboard_card" android:text="右后 · 等待数据" android:textColor="@color/text_primary" android:textSize="16sp" />
    </LinearLayout>
    <TextView android:id="@+id/client_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="20dp" android:background="@drawable/dashboard_card" android:text="等待车辆数据" android:textSize="18sp" android:textColor="@color/text_primary" />
    <Button android:id="@+id/client_battery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="后台运行设置" />
    <TextView android:id="@+id/client_battery_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/text_secondary" />
    <EditText android:id="@+id/client_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/dashboard_title_hint" android:inputType="text" android:text="欢迎公主上车" android:textSize="16sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
      <EditText android:id="@+id/client_province" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:hint="@string/fuel_province_hint" android:inputType="text" android:text="上海" android:textSize="14sp" />
      <EditText android:id="@+id/client_fuel_grade" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:hint="@string/fuel_grade_hint" android:inputType="text" android:text="92#" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
      <EditText android:id="@+id/client_host" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:hint="@string/tpms_scan_host" android:inputType="textUri" android:text="192.168.0.10" android:textSize="14sp" />
      <EditText android:id="@+id/client_port" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:hint="@string/tpms_scan_port" android:inputType="number" android:text="35000" android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
      <Button android:id="@+id/client_start" android:backgroundTint="@color/primary" android:textColor="@color/surface" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/bridge_start" />
      <Button android:id="@+id/client_stop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/bridge_stop" />
      <Button android:id="@+id/client_copy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/usb_copy" />
    </LinearLayout>
    <Button android:id="@+id/client_toggle_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="展开 / 收起连接日志" />
    <ScrollView android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="12dp" android:id="@+id/client_log_panel" android:visibility="gone" android:background="@color/surface_variant" android:padding="10dp">
      <TextView android:id="@+id/client_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/text_primary" android:textIsSelectable="true" android:textSize="11sp" />
    </ScrollView>
  </LinearLayout>
</ScrollView>